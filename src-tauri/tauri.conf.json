{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "limusic",
  "version": "1.2.0-rc.3",
  "identifier": "com.limusic.desktop",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Limusic",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": ["deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-4-1",
          "libnss3",
          "libnspr4",
          "libasound2t64 | libasound2",
          "libatk1.0-0t64 | libatk1.0-0",
          "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
          "libatspi2.0-0t64 | libatspi2.0-0",
          "libcups2t64 | libcups2",
          "libdbus-1-3",
          "libgbm1",
          "libxkbcommon0",
          "libxcomposite1",
          "libxdamage1",
          "libxrandr2",
          "libmpv2",
          "libc6 (>= 2.39)"
        ]
      },
      "rpm": {
        "depends": [
          "gtk4",
          "nss",
          "alsa-lib",
          "at-spi2-atk",
          "cups-libs",
          "mesa-libgbm",
          "libxkbcommon",
          "libXcomposite",
          "libXdamage",
          "libXrandr",
          "mpv-libs"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SimoHypers/limusic/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MENDMzA1NUFGMDI0NTQKUldSVUpQQmFCY01NbENPbW9XOTRvVU9YQ2lCQytOU2RyeDhHNFhkWHlNc1dITkFmbkd1ZTBlM1gK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
